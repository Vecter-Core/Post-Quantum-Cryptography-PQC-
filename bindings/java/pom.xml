<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.vecter</groupId>
  <artifactId>vpqc</artifactId>
  <version>0.0.1</version>
  <packaging>jar</packaging>
  <name>vpqc</name>
  <description>Post-quantum cryptography with safe defaults (pre-release, unaudited). Java binding over the Rust core via the Foreign Function &amp; Memory API.</description>
  <url>https://github.com/Vecter-Core/Post-Quantum-Cryptography-PQC-</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Path to the directory holding libvpqc_ffi.so / .dylib / vpqc_ffi.dll -->
    <vpqc.library.path>${project.basedir}/../../target/release</vpqc.library.path>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- JDK 21: the Foreign Function & Memory API is a preview feature. -->
    <profile>
      <id>jdk21-preview</id>
      <activation><jdk>21</jdk></activation>
      <properties>
        <java.release>21</java.release>
        <preview.args>--enable-preview</preview.args>
      </properties>
    </profile>
    <!-- JDK 22 and newer: the API is final. -->
    <profile>
      <id>jdk22-plus</id>
      <activation><jdk>[22,)</jdk></activation>
      <properties>
        <java.release>22</java.release>
        <preview.args></preview.args>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${java.release}</release>
          <compilerArgs>
            <arg>${preview.args}</arg>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>${preview.args} --enable-native-access=ALL-UNNAMED -Dvpqc.library.path=${vpqc.library.path}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
